{
  "name": "iot-ts",
  "version": "2.0.0",
  "description": "API REST WSN IoT",
  "author": "Giancarlo Culcay <gianculcay@gmail.com>",
  "license": "ISC",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ./dist/src/index.js",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest --verbose  --forceExit --runInBand  --detectOpenHandles",
    "e2e:windows": "set \"NODE_ENV=e2e\" && jest --verbose  --forceExit --runInBand",
    "e2e:coverage:windows": "set \"NODE_ENV=e2e\" && jest --runInBand --forceExit --coverage",
    "e2e": "NODE_ENV=e2e jest --verbose  --forceExit --runInBand",
    "e2e:coverage": "NODE_ENV=e2e jest --verbose --forceExit --runInBand --coverage",
    "e2e:ci": "NODE_ENV=ci jest --verbose --forceExit --runInBand"
  },
  "keywords": [
    "api rest",
    "mqtt",
    "wsn",
    "iot"
  ],
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.2",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "morgan": "^1.11.0",
    "mqtt": "^5.15.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
